#!/usr/bin/env bash
# Bump Sell PWA VERSION before pushes to main so the deploy includes it.
# Enable with: npm run hooks:install
set -euo pipefail

zero="0000000000000000000000000000000000000000"
should_bump=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  should_bump=1
done

if [ "$should_bump" -ne 1 ]; then
  exit 0
fi

set +e
node "$(dirname "$0")/../scripts/pre-push-bump-pwa.mjs"
status=$?
set -e

if [ "$status" -eq 2 ]; then
  # Soft stop: bump commit created; push again to include it.
  exit 1
fi
exit "$status"
