# Public API (Laravel). Required in production — mocks will not auto-enable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Platform domain used for subdomain storefront routing
NEXT_PUBLIC_STORE_PLATFORM_DOMAIN=bizgrid.shop

# Google Places (Maps JavaScript API + Places library). Used for admin location
# zones and storefront checkout address autocomplete. Restrict the key by HTTP
# referrer in Google Cloud. Without this key, plain address inputs are used.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Meta (Facebook) Pixel — PageView tracking on all pages when set
# NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel — PageView tracking on all pages when set
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Google tag (GA4 G-XXXXXXXX / Ads AW-XXXXXXXX) — set when ready
# NEXT_PUBLIC_GOOGLE_TAG_ID=

# Code workbench is off by default. Set to true only for local workbench development.
# NEXT_PUBLIC_ENABLE_CODE_WORKBENCH=true

# Single LLM + tools builder agent (SessionAgent → Critic). Off by default — waterfall stays the fallback.
# NEXT_PUBLIC_ENABLE_BUILDER_TOOL_AGENT=true

# Force mock API responses in local development only (never set in production)
# NEXT_PUBLIC_USE_MOCKS=true

# Show "Enter the demo" on /login and use /demo one-click merchant access.
# Requires backend STOREHAUSE_DEMO_LOGIN=true + DemoMerchantSeeder.
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Server-only keys (never use NEXT_PUBLIC_ for secrets)
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_SECRET_KEY=
